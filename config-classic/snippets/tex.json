      "\\\\langle ${1:A} \\\\rangle$0"
    ],
    "description": "<A>",
    "keywords": "average mean expectation quantum angle brackets"
  },
  "Absolute value": {
    "prefix": [
      "abs"
    ],
    "body": [
      "\\\\lvert ${1:x} \\\\rvert$0"
    ],
    "description": "|x| (amsmath)",
    "keywords": "absolute modulus magnitude bars"
  },
  "Norm": {
    "prefix": [
      "norm"
    ],
    "body": [
      "\\\\lVert ${1:x} \\\\rVert$0"
    ],
    "description": "||x|| (amsmath)",
    "keywords": "norm length magnitude double bars"
  },
  "Vector": {
    "prefix": [
      "vec"
    ],
    "body": [
      "\\\\vec{${1:r}}$0"
    ],
    "description": "arrow over r",
    "keywords": "vector arrow"
  },
  "Bold vector": {
    "prefix": [
      "bvec"
    ],
    "body": [
      "\\\\mathbf{${1:r}}$0"
    ],
    "description": "bold r",
    "keywords": "vector bold"
  },
  "Hat": {
    "prefix": [
      "hat"
    ],
    "body": [
      "\\\\hat{${1:H}}$0"
    ],
    "description": "H with a hat (operators)",
    "keywords": "operator hat unit vector"
  },
  "Scientific number": {
    "prefix": [
      "sci"
    ],
    "body": [
      "${1:1.0} \\\\times 10^{${2:3}}$0"
    ],
    "description": "1.0 x 10^3",
    "keywords": "scientific notation exponent power ten times"
  },
  "Inline maths": {
    "prefix": [
      "im"
    ],
    "body": [
      "\\$$1\\$$0"
    ],
    "description": "$...$ in the text",
    "keywords": "inline math maths dollar in text"
  },
  "Display maths": {
    "prefix": [
      "dm"
    ],
    "body": [
      "\\\\[",
      "\t$1",
      "\\\\]",
      "$0"
    ],
    "description": "Unnumbered displayed maths",
    "keywords": "display math maths centred unnumbered"
  }
}
