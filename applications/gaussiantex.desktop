[Desktop Entry]
Type=Application
Name=GaussianTeX
GenericName=LaTeX editor
Comment=LaTeX projects in GaussianVim: templates (thesis, PRB, arXiv, Nature, notes, book, slides), live PDF, spell and grammar check
Exec=@HOME@/.local/bin/gtex
Icon=@HOME@/.local/share/gaussianvim/brand/gaussiantex.svg
Terminal=false
Categories=Office;Publishing;Science;
Keywords=latex;tex;overleaf;thesis;paper;gaussiantex;
StartupWMClass=GaussianTeX
